"""
Customer Lifetime Value Prediction
Run from this project folder: python src/train_clv.py
Dataset is synthetic and intended for learning/demo purposes.
"""
from pathlib import Path
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestRegressor, HistGradientBoostingRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / "data" / "customer_clv_sample.csv"
OUT = ROOT / "outputs"
OUT.mkdir(exist_ok=True)

df = pd.read_csv(DATA)
features = ["frequency", "recency_days", "avg_order_value", "tenure_days",
            "historical_monetary_value", "discount_rate", "returns_rate"]
X, y = df[features], df["future_12m_clv"]

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42
)

models = {
    "Random Forest": RandomForestRegressor(
        n_estimators=250, min_samples_leaf=2, random_state=42, n_jobs=-1
    ),
    "Gradient Boosting": HistGradientBoostingRegressor(
        max_iter=150, learning_rate=0.08, random_state=42
    )
}
rows, fitted = [], {}
for name, model in models.items():
    model.fit(X_train, y_train)
    pred = np.maximum(0, model.predict(X_test))
    rows.append({
        "model": name,
        "MAE": mean_absolute_error(y_test, pred),
        "RMSE": mean_squared_error(y_test, pred) ** 0.5,
        "R2": r2_score(y_test, pred)
    })
    fitted[name] = model

scores = pd.DataFrame(rows).sort_values("RMSE")
scores.to_csv(OUT / "model_metrics.csv", index=False)
best_name = scores.iloc[0]["model"]
best_model = fitted[best_name]

all_predictions = df[["customer_id"]].copy()
all_predictions["predicted_12m_clv"] = np.maximum(0, best_model.predict(X))
all_predictions["clv_segment"] = pd.qcut(
    all_predictions["predicted_12m_clv"].rank(method="first"),
    q=3, labels=["Low Value", "Medium Value", "High Value"]
)
all_predictions.to_csv(OUT / "customer_clv_predictions.csv", index=False)

# Visualizations
plt.figure(figsize=(8, 5))
plt.scatter(y_test, np.maximum(0, best_model.predict(X_test)), alpha=.55)
plt.xlabel("Actual 12-month CLV")
plt.ylabel("Predicted 12-month CLV")
plt.title(f"Actual vs Predicted CLV — {best_name}")
plt.tight_layout()
plt.savefig(OUT / "actual_vs_predicted.png", dpi=160)
plt.close()

segment_counts = all_predictions["clv_segment"].value_counts().reindex(
    ["Low Value", "Medium Value", "High Value"]
)
plt.figure(figsize=(7, 4))
segment_counts.plot(kind="bar")
plt.ylabel("Number of customers")
plt.title("Customer Segments by Predicted CLV")
plt.tight_layout()
plt.savefig(OUT / "customer_segments.png", dpi=160)
plt.close()

print("Model comparison:")
print(scores.to_string(index=False))
print(f"Best model: {best_name}")
print(f"Outputs saved to: {OUT}")
